# Telegram bot token from @BotFather
BOT_TOKEN=123456:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Comma-separated whitelist. Empty WHITELIST_USER_IDS + empty WHITELIST_USERNAMES => bot rejects everyone.
WHITELIST_USER_IDS=123456789
WHITELIST_USERNAMES=

# Re-fire interval (minutes) for unacknowledged reminders
REPEAT_INTERVAL_MIN=10

# Display timezone (UTC stored internally). Asia/Baku is fixed by design but configurable.
TIMEZONE=Asia/Baku

LOG_LEVEL=INFO
